{%- doc -%}
  Showcases bundle products from a merchant-chosen collection (e.g. "Bundles").
  Keep bundles as real products (fixed bundle apps or manually-priced bundle
  products both work) tagged into that collection — this section just needs
  the collection picker set once.
{%- enddoc -%}

{%- liquid
  assign bundle_collection = section.settings.collection
-%}

{% if bundle_collection != blank %}
  <div
    class="section section--{{ section.settings.section_width }} bundle-showcase spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="bundle-showcase__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="bundle-showcase__list" role="list">
      {%- for bundle_product in bundle_collection.products limit: section.settings.product_limit -%}
        <li class="bundle-showcase__item">
          <a href="{{ bundle_product.url }}" class="bundle-showcase__link">
            {% render 'image', image: bundle_product.featured_image, height: 400, class: 'bundle-showcase__image' %}
            {%- if bundle_product.compare_at_price > bundle_product.price -%}
              {%- assign savings = bundle_product.compare_at_price | minus: bundle_product.price -%}
              <span class="bundle-showcase__save">Save {{ savings | money }}</span>
            {%- endif -%}
            <span class="bundle-showcase__title">{{ bundle_product.title }}</span>
            <span class="bundle-showcase__price">
              {{ bundle_product.price | money }}
              {%- if bundle_product.compare_at_price > bundle_product.price -%}
                <s class="bundle-showcase__compare-price">{{ bundle_product.compare_at_price | money }}</s>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .bundle-showcase__heading {
    font-family: var(--font-heading--family);
    margin: 0 0 1.25rem;
  }

  .bundle-showcase__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .bundle-showcase__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bundle-showcase__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-decoration: none;
    color: inherit;
  }

  .bundle-showcase__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--style-border-radius-cards, 16px);
  }

  .bundle-showcase__save {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.25em 0.75em;
    border-radius: 999px;
    background: var(--color-foreground, #16151c);
    color: var(--color-background, #fff);
    font-size: var(--font-size--xs, 0.75rem);
    font-weight: 700;
  }

  .bundle-showcase__title {
    font-weight: 600;
  }

  .bundle-showcase__compare-price {
    margin-left: 0.5em;
    color: color-mix(in srgb, currentColor 55%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best-selling bundles"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Bundle collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max bundles to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Bundle showcase",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
