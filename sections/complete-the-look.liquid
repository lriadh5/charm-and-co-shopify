{% comment %}
  Attribute-aware cross-sell: pulls other products that share the current
  product's "capsule" (e.g. Pink Pop, Midnight, Ocean) instead of a generic
  "related products" feed. Tag a product `capsule_<collection-handle>` (for
  example `capsule_pink-pop`) and make sure an automated collection with that
  handle exists — the section does the rest with no code changes per capsule.
{% endcomment %}

{%- liquid
  assign product = section.settings.product | default: product
  assign capsule_tag = blank

  for tag in product.tags
    if tag contains 'capsule_'
      assign capsule_tag = tag
      break
    endif
  endfor

  if capsule_tag != blank
    assign capsule_handle = capsule_tag | remove_first: 'capsule_'
    assign look_collection = collections[capsule_handle]
  endif

  if look_collection == blank or look_collection.products_count < 2
    assign look_collection = product.collections.first
  endif
-%}

{% if look_collection != blank %}
  <div
    class="section section--{{ section.settings.section_width }} complete-the-look spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="complete-the-look__header">
      <h2 class="complete-the-look__heading">{{ section.settings.heading }}</h2>
      {%- if capsule_tag != blank -%}
        <p class="complete-the-look__subheading">{{ section.settings.capsule_subheading }}</p>
      {%- endif -%}
    </div>

    <ul class="complete-the-look__list" role="list">
      {%- assign shown = 0 -%}
      {%- for look_product in look_collection.products -%}
        {%- if look_product.id == product.id -%}
          {%- continue -%}
        {%- endif -%}
        {%- if shown >= section.settings.product_limit -%}
          {%- break -%}
        {%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <li class="complete-the-look__item">
          <a href="{{ look_product.url }}" class="complete-the-look__link">
            {% render 'image', image: look_product.featured_image, height: 320, class: 'complete-the-look__image' %}
            <span class="complete-the-look__title">{{ look_product.title }}</span>
            <span class="complete-the-look__price">{{ look_product.price | money }}</span>
            {% render 'price-tier-badge', product: look_product %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .complete-the-look {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .complete-the-look__heading {
    font-family: var(--font-heading--family);
    margin: 0;
  }

  .complete-the-look__subheading {
    color: color-mix(in srgb, currentColor 65%, transparent);
    margin: 0.25rem 0 0;
  }

  .complete-the-look__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .complete-the-look__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .complete-the-look__link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-decoration: none;
    color: inherit;
  }

  .complete-the-look__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--style-border-radius-cards, 16px);
  }

  .complete-the-look__title {
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 600;
  }

  .complete-the-look__price {
    font-size: var(--font-size--sm, 0.875rem);
    color: color-mix(in srgb, currentColor 65%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complete the look",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Anchor product",
      "info": "Only needed on non-product pages (e.g. homepage) to pick which capsule to feature. On a product page this defaults to the product being viewed."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the look"
    },
    {
      "type": "text",
      "id": "capsule_subheading",
      "label": "Subheading shown when a capsule match is found",
      "default": "More from this set"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Complete the look",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
