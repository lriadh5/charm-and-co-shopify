{% comment %}
  Vertical video / UGC grid for TikTok- and Reels-style social proof. Each
  clip is a block so merchants can swap creators/videos without code changes.
  Accepts either a Shopify-hosted video file or an external embed URL.
{% endcomment %}

<div
  class="section section--{{ section.settings.section_width }} ugc-social spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="ugc-social__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="ugc-social__list" role="list">
    {%- for block in section.blocks -%}
      <li class="ugc-social__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{
            block.settings.video
            | video_tag: image_size: '400x', autoplay: false, loop: false, controls: true, muted: false, class: 'ugc-social__media'
          }}
        {%- elsif block.settings.embed_url != blank -%}
          <a
            href="{{ block.settings.embed_url }}"
            target="_blank"
            rel="noopener"
            class="ugc-social__embed-link"
          >
            {% render 'image', image: block.settings.poster, height: 500, class: 'ugc-social__media' %}
          </a>
        {%- endif -%}
        {%- if block.settings.caption != blank -%}
          <p class="ugc-social__caption">{{ block.settings.caption }}</p>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .ugc-social__heading {
    font-family: var(--font-heading--family);
    margin: 0 0 1.25rem;
  }

  .ugc-social__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ugc-social__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ugc-social__media {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--style-border-radius-cards, 16px);
    display: block;
  }

  .ugc-social__caption {
    margin: 0.5rem 0 0;
    font-size: var(--font-size--sm, 0.875rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UGC / social video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen on your FYP"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video clip",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted video"
        },
        {
          "type": "url",
          "id": "embed_url",
          "label": "Or: link to external video (TikTok/IG/YouTube)",
          "info": "Used only if no video is uploaded above."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image (for external video link)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "@creator"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC / social video",
      "category": "t:categories.storytelling",
      "blocks": [
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" }
      ]
    }
  ]
}
{% endschema %}
