{%- doc -%}
  Renders visible breadcrumb navigation plus matching BreadcrumbList JSON-LD.
  Horizon ships Product structured data via the `structured_data` filter but
  has no breadcrumb trail anywhere (visual or structured) — this fills that
  gap for both collection and product pages.

  @param {object} [product] - current product, on product pages
  @param {object} [collection] - current collection, on collection pages or
    a product page reached through a collection

  @example
  {% render 'breadcrumbs', product: product, collection: collection %}
{%- enddoc -%}

{%- liquid
  assign crumb_collection = collection | default: product.collections.first
-%}

<nav class="breadcrumbs section section--page-width" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item"><a href="{{ request.origin }}">{{ shop.name }}</a></li>
    {%- if crumb_collection != blank -%}
      <li class="breadcrumbs__item">
        {%- if product != blank -%}
          <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
        {%- else -%}
          <span aria-current="page">{{ crumb_collection.title }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
    {%- if product != blank -%}
      <li class="breadcrumbs__item"><span aria-current="page">{{ product.title }}</span></li>
    {%- endif -%}
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ shop.name | json }},
        "item": {{ request.origin | json }}
      }
      {%- if crumb_collection != blank -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ crumb_collection.title | json }},
          "item": {{ crumb_collection.url | prepend: request.origin | json }}
        }
      {%- endif -%}
      {%- if product != blank -%}
        ,{
          "@type": "ListItem",
          "position": {% if crumb_collection != blank %}3{% else %}2{% endif %},
          "name": {{ product.title | json }},
          "item": {{ product.url | prepend: request.origin | json }}
        }
      {%- endif -%}
    ]
  }
</script>

{% stylesheet %}
  .breadcrumbs {
    padding-block: 0.75rem;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size--xs, 0.8rem);
    color: color-mix(in srgb, currentColor 65%, transparent);
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: "/";
    margin-inline-start: 0.35rem;
    opacity: 0.5;
  }

  .breadcrumbs__item a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs__item a:hover {
    text-decoration: underline;
  }

  .breadcrumbs__item [aria-current="page"] {
    color: inherit;
    font-weight: 600;
  }
{% endstylesheet %}
